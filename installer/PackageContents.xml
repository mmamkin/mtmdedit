<?xml version="1.0" encoding="utf-8"?>
<!--
  Autoloader manifest. AutoCAD loads bundles from the ApplicationPlugins
  folders (trusted locations, so SECURELOAD does not prompt).
  SeriesMin/SeriesMax pin the module to AutoCAD 2027 (R26.0): the .arx is
  binary compatible with that release only.
-->
<ApplicationPackage SchemaVersion="1.0"
                    AutodeskProduct="AutoCAD"
                    ProductType="Application"
                    Name="MtmdEdit"
                    AppVersion="4.0.0"
                    Description="Editor for DTEXT, MTEXT and dimension text (command TE)"
                    Author="Mansur Mamkin"
                    ProductCode="{6B7F3C1E-2A64-4D8B-9E35-7C1A0F4D2B91}"
                    UpgradeCode="{1D5E8A72-93C4-4F0B-A6D2-3B9E7C5F8A14}">
  <CompanyDetails Name="Mtmlab" Url="http://www.mtmlab.ru" />
  <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R26.0" SeriesMax="R26.0" />
  <Components Description="AutoCAD 2027">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R26.0" SeriesMax="R26.0" />
    <ComponentEntry AppName="MtmdEdit"
                    ModuleName="./Contents/MtmdEdit2027.arx"
                    AppDescription="MtmdEdit text editor"
                    LoadOnAutoCADStartup="True" />
  </Components>
</ApplicationPackage>
